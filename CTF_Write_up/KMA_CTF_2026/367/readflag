#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

int main(void) {
	const char *path = "/flag.txt";
	int fd = open(path, O_RDONLY);
	if (fd < 0) {
		return 1;
	}

	char buf[1024];
	ssize_t n = 0;
	while ((n = read(fd, buf, sizeof(buf))) > 0) {
		ssize_t off = 0;
		while (off < n) {
			ssize_t w = write(STDOUT_FILENO, buf + off, (size_t)(n - off));
			if (w <= 0) {
				close(fd);
				return 1;
			}
			off += w;
		}
	}

	close(fd);
	return 0;
}
